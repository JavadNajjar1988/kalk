# فایل تنظیمات محیطی برای Kalk
# این فایل شامل متغیرهای محیطی برای Docker Compose و Backend است

# ==========================================
# تنظیمات دیتابیس
# ==========================================
DB_URL=postgresql+asyncpg://postgres:postgres@db:5432/kalk

# ==========================================
# تنظیمات احراز هویت
# ==========================================
# وقتی true باشد، تمام بررسی‌های احراز هویت نادیده گرفته می‌شود (برای توسعه)
DISABLE_AUTH=false

# رمز عبور پیش‌فرض ادمین (باید در تولید تغییر کند)
ADMIN_BOOTSTRAP_PASSWORD=admin123

# JWT Secret (تولید خودکار اگر خالی باشد)
JWT_SECRET=kalk-dev-local-jwt-secret
JWT_ALG=HS256

# ==========================================
# تنظیمات CORS (Cross-Origin Resource Sharing)
# ==========================================
# لیست URLهای مجاز برای دسترسی به API
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# ==========================================
# تنظیمات نقشه و نقشه‌کشی
# ==========================================
# URL سرور نقشه (TileServer)
TILESERVER_URL=http://127.0.0.1:8480

# مسیر ریشه فایل‌های نقشه در سیستم فایل
# برای Windows: مسیر را به صورت D:/maps وارد کنید (نه D:\maps)
# برای Linux/Mac: مسیر را به صورت /mnt/maps وارد کنید
# اگر تنظیم نشده باشد، از مسیر محلی backend/static/maps استفاده می‌شود
EXTERNAL_MAPS_PATH=./backend/static/maps

# مسیر ریشه تایل‌ها در داخل کانتینر (معمولاً تغییر نمی‌شود)
# اگر EXTERNAL_MAPS_PATH تنظیم شده باشد، از /mnt/external-maps استفاده می‌شود
FILESYSTEM_TILE_ROOT=/mnt/external-maps

# URL سرور نقشه خارجی برای داده‌های سنگین (10TB+)
# این سرور با profile heavy-maps راه‌اندازی می‌شود
EXTERNAL_TILESERVER_URL=http://127.0.0.1:8481

# ==========================================
# تنظیمات دیگر
# ==========================================
# پیشوند API (معمولاً تغییر نمی‌شود)
API_PREFIX=/api

# مدت زمان انقضای Access Token (دقیقه)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# دستورالعمل استفاده از هارد خارجی
# ==========================================
# برای استفاده از هارد خارجی (10TB+):
# 1. EXTERNAL_MAPS_PATH را به مسیر هارد خارجی خود تغییر دهید
#    مثال Windows: EXTERNAL_MAPS_PATH=D:/maps
#    مثال Linux: EXTERNAL_MAPS_PATH=/mnt/maps
#
# 2. برای راه‌اندازی سرور نقشه خارجی:
#    docker compose --profile heavy-maps up -d external-tileserver
#
# 3. در داشبورد، سرور نقشه خارجی را به عنوان SDI Server ثبت کنید:
#    URL: http://127.0.0.1:8481
#
# 4. برای جزئیات بیشتر، فایل SEPARATE_TILESERVER_SETUP.md را مطالعه کنید
