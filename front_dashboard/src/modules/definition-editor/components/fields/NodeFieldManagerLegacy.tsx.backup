                    </Typography>
                    <Chip 
                      label="به زودی" 
                      size="small"
                      sx={{ 
                        mt: 2,
                        bgcolor: 'rgba(148, 163, 184, 0.2)',
                        color: '#64748B',
                        fontWeight: 500,
                      }} 
                    />
                  </Paper>
                </Grid>
              </Grid>
            </Box>
          )}

          {currentStep === 2 && (
            <Box>
              <Box sx={{ textAlign: 'center', mb: 4 }}>
                <Typography 
                  variant="h5" 
                  gutterBottom
                  sx={{
                    fontWeight: 700,
                    background: 'linear-gradient(45deg, #4A90E2 30%, #7BB3F0 90%)',
                    backgroundClip: 'text',
                    WebkitBackgroundClip: 'text',
                    WebkitTextFillColor: 'transparent',
                  }}
                >
