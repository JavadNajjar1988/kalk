                            <HelpTooltip
                              title="استایل پیام خطا"
                              description="محل/نوع نمایش پیام اعتبارسنجی."
                              example="«پیام قرمز زیر فیلد»"
                            />
                          </Box>
                        </Grid>
                      </Grid>
                    )}
                  </Grid>
                </Grid>
              </Paper>
            </Box>
          )}

          {currentStep === 3 && (
            <Box>
              <Box sx={{ textAlign: 'center', mb: 4 }}>
                <Typography 
                  variant="h5" 
                  gutterBottom
