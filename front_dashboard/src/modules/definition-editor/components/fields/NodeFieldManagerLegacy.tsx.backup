                        </Typography>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>موقعیت برچسب</InputLabel>
                            <Select
                              value={formData.inlineLabelPosition || 'left'}
                              onChange={(e) => handleChange('inlineLabelPosition', e.target.value)}
                              label="موقعیت برچسب"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="left">چپ</MenuItem>
                              <MenuItem value="top">بالا</MenuItem>
                            </Select>
