                        </Box>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>اندازه پاپ‌اور</InputLabel>
                            <Select
                              value={formData.popoverSize || 'medium'}
                              onChange={(e) => handleChange('popoverSize', e.target.value)}
                              label="اندازه پاپ‌اور"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="small">کوچک</MenuItem>
                              <MenuItem value="medium">متوسط</MenuItem>
                              <MenuItem value="large">بزرگ</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="اندازه پاپ‌اور"
                            description="عرض و ارتفاع پاپ‌اور."
                            example="«بزرگ = fullscreen»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>موقعیت</InputLabel>
                            <Select
                              value={formData.popoverPosition || 'bottom'}
                              onChange={(e) => handleChange('popoverPosition', e.target.value)}
                              label="موقعیت"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="top">بالا</MenuItem>
                              <MenuItem value="bottom">پایین</MenuItem>
                              <MenuItem value="left">چپ</MenuItem>
                              <MenuItem value="right">راست</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="موقعیت"
                            description="محل ظاهرشدن پاپ‌اور."
                            example="«پایین: زیر دکمه»"
                          />
                        </Box>
                      </Grid>
                    </>
                  )}
                  
                  {/* Inline Configuration */}
                  {formData.enableVariant && formData.variant === 'inline' && (
                    <>
                      <Grid item xs={12}>
                        <Typography variant="subtitle2" sx={{ color: 'text.secondary', mb: 2 }}>
