                      <Chip 
                        label="انتخاب شده" 
                        size="small"
                        sx={{ 
                          mt: 2,
                          bgcolor: 'rgba(74, 144, 226, 0.1)',
                          color: '#4A90E2',
                          fontWeight: 600,
                        }} 
