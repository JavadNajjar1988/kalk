                        </Box>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <TextField
                            fullWidth
                            type="number"
                            label="عرض برچسب (پیکسل)"
                            value={formData.inlineLabelWidth || 120}
                            onChange={(e) => handleChange('inlineLabelWidth', parseInt(e.target.value) || 120)}
                            inputProps={{ min: 80, max: 300 }}
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                          <HelpTooltip
                            title="عرض برچسب"
                            description="عرض ناحیه برچسب به پیکسل."
                            example="«120 = 120 پیکسل»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>فاصله‌گذاری</InputLabel>
                            <Select
                              value={formData.inlineSpacing || 'normal'}
                              onChange={(e) => handleChange('inlineSpacing', e.target.value)}
                              label="فاصله‌گذاری"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="compact">فشرده</MenuItem>
                              <MenuItem value="normal">عادی</MenuItem>
                              <MenuItem value="comfortable">راحت</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="فاصله‌گذاری"
                            description="فضای بین عناصر."
                            example="«راحت = فضای بیشتر»"
                          />
                        </Box>
                      </Grid>
                    </>
                  )}
                  
                  {/* Selection Aid */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableSelectionAid || false}
                            onChange={(e) => handleChange('enableSelectionAid', e.target.checked)}
                            size="small"
                          />
                        }
                        label="کمک انتخاب"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="کمک انتخاب"
                        description="کمکِ انتخاب از پیشنهادها (تکی/چندتایی) برای پرکردن متن."
                        example="«انتخاب چند برچسب از لیست»"
                      />
                    </Box>
                    {formData.enableSelectionAid && (
                      <FormControl fullWidth>
                        <InputLabel>نوع کمک انتخاب</InputLabel>
                        <Select
                          value={formData.selectionAid || 'none'}
                          onChange={(e) => handleChange('selectionAid', e.target.value)}
                          label="نوع کمک انتخاب"
                          sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                        >
                          <MenuItem value="none">بدون کمک</MenuItem>
                          <MenuItem value="single">انتخاب تکی از پیشنهادها</MenuItem>
                          <MenuItem value="multi">انتخاب چندتایی از پیشنهادها</MenuItem>
                        </Select>
                      </FormControl>
                    )}
                  </Grid>
                  
                  {/* Visual Enhancements */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableVisualEnhancements || false}
                            onChange={(e) => handleChange('enableVisualEnhancements', e.target.checked)}
                            size="small"
                          />
                        }
                        label="تنظیمات ظاهری"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="تنظیمات ظاهری"
                        description="اندازه، آیکون، پیشوند/پسوند، شمارنده و دکمه کپی."
                        example="اندازه کوچک/متوسط/بزرگ/کامل"
                      />
                    </Box>
                    {formData.enableVisualEnhancements && (
                      <Grid container spacing={2}>
                        <Grid item xs={6} md={3}>
                          <Box sx={{ display: 'flex', alignItems: 'center' }}>
                            <FormControl fullWidth>
                              <InputLabel>اندازه</InputLabel>
                              <Select
                                value={formData.size || 'md'}
                                onChange={(e) => handleChange('size', e.target.value)}
                                label="اندازه"
                                sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                              >
                                <MenuItem value="sm">کوچک</MenuItem>
                                <MenuItem value="md">متوسط</MenuItem>
                                <MenuItem value="lg">بزرگ</MenuItem>
                                <MenuItem value="full">کامل</MenuItem>
                              </Select>
                            </FormControl>
                            <HelpTooltip
                              title="اندازه"
                              description="کنترل عرض/بلندای ورودی در فرم."
                              example="«کامنت ⇒ بزرگ/کامل»"
                            />
                          </Box>
                        </Grid>
                        
                        <Grid item xs={6} md={3}>
                          <Box sx={{ display: 'flex', alignItems: 'center' }}>
                            <TextField
                              fullWidth
                              label="آیکون"
                              value={formData.icon || ''}
                              onChange={(e) => handleChange('icon', e.target.value)}
                              placeholder="نام آیکون"
                              sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                            />
                            <HelpTooltip
                              title="آیکون / پیشوند / پسوند"
                              description="نشانهٔ بصری یا متن ثابت قبل/بعد از ورودی."
                              example="«پسوند: .iran»"
                            />
                          </Box>
                        </Grid>
                        
                        <Grid item xs={6} md={3}>
                          <TextField
                            fullWidth
                            label="پیشوند"
                            value={formData.prefix || ''}
                            onChange={(e) => handleChange('prefix', e.target.value)}
                            placeholder="متن پیشوند"
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                        </Grid>
                        
                        <Grid item xs={6} md={3}>
                          <TextField
                            fullWidth
                            label="پسوند"
                            value={formData.suffix || ''}
                            onChange={(e) => handleChange('suffix', e.target.value)}
                            placeholder="متن پسوند"
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                        </Grid>
                        
                        <Grid item xs={6}>
                          <Box sx={{ display: 'flex', alignItems: 'center' }}>
                            <FormControl fullWidth>
                              <InputLabel>نمایش شمارنده</InputLabel>
                              <Select
                                value={formData.counterDisplay || 'off'}
                                onChange={(e) => handleChange('counterDisplay', e.target.value)}
                                label="نمایش شمارنده"
                                sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                              >
                                <MenuItem value="off">خاموش</MenuItem>
                                <MenuItem value="bottom">پایین فیلد</MenuItem>
                                <MenuItem value="inside">داخل فیلد</MenuItem>
                              </Select>
                            </FormControl>
                            <HelpTooltip
                              title="نمایش شمارنده"
                              description="شمارندهٔ کاراکتر برای محدودیت‌ها."
                              example="«۱۲/۱۴۰»"
                            />
                          </Box>
                        </Grid>
                        
                        <Grid item xs={6}>
                          <Box sx={{ display: 'flex', alignItems: 'center' }}>
                            <FormControlLabel
                              control={
                                <Switch
                                  checked={formData.copyButton || false}
                                  onChange={(e) => handleChange('copyButton', e.target.checked)}
                                  size="small"
                                />
                              }
                              label="دکمه کپی"
                            />
                            <HelpTooltip
                              title="دکمه کپی"
                              description="کپی سریع مقدار فیلد به کلیپ‌بورد."
                              example="«کپی شناسه»"
                            />
                          </Box>
                        </Grid>
                      </Grid>
                    )}
                  </Grid>
                  
                  {/* Style Configuration */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableStyleConfig || false}
                            onChange={(e) => handleChange('enableStyleConfig', e.target.checked)}
                            size="small"
                          />
                        }
                        label="تنظیمات استایل"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="تنظیمات استایل"
                        description="ظاهر فیلد هنگام read-only و نحوه نمایش پیام خطا."
                        example="محل/نوع نمایش پیام اعتبارسنجی"
                      />
                    </Box>
                    {formData.enableStyleConfig && (
                      <Grid container spacing={2}>
                        <Grid item xs={6}>
                          <Box sx={{ display: 'flex', alignItems: 'center' }}>
                            <FormControl fullWidth>
                              <InputLabel>استایل فقط‌خواندنی</InputLabel>
                              <Select
                                value={formData.readOnlyStyle || 'normal'}
                                onChange={(e) => handleChange('readOnlyStyle', e.target.value)}
                                label="استایل فقط‌خواندنی"
                                sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                              >
                                <MenuItem value="normal">عادی</MenuItem>
                                <MenuItem value="disabled">غیرفعال</MenuItem>
                                <MenuItem value="plain">ساده</MenuItem>
                              </Select>
                            </FormControl>
                            <HelpTooltip
                              title="استایل فقط‌خواندنی"
                              description="ظاهر فیلد هنگام read-only."
                              example="«رنگ کم‌رنگ و بدون Border»"
                            />
                          </Box>
                        </Grid>
                        
                        <Grid item xs={6}>
                          <Box sx={{ display: 'flex', alignItems: 'center' }}>
                            <FormControl fullWidth>
                              <InputLabel>استایل پیام خطا</InputLabel>
                              <Select
                                value={formData.validationMessageStyle || 'bottom'}
                                onChange={(e) => handleChange('validationMessageStyle', e.target.value)}
                                label="استایل پیام خطا"
                                sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                              >
                                <MenuItem value="bottom">زیر فیلد</MenuItem>
                                <MenuItem value="tooltip">راهنمای ابزار</MenuItem>
                                <MenuItem value="inline">درون خط</MenuItem>
                              </Select>
