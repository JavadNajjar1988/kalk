                    fontWeight: 700,
                    background: 'linear-gradient(45deg, #4A90E2 30%, #7BB3F0 90%)',
                    backgroundClip: 'text',
                    WebkitBackgroundClip: 'text',
                    WebkitTextFillColor: 'transparent',
                  }}
                >
                  قوانین حاکم بر فیلد
                </Typography>
                <Typography variant="body1" color="text.secondary" sx={{ fontSize: '1.1rem', opacity: 0.8, mb: 4 }}>
