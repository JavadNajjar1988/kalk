                </Typography>
              </Box>
              
              {/* ویژگی‌های عمومی - اجباری */}
              <Paper
                sx={{
                  p: 3,
                  mb: 3,
                  borderRadius: '12px',
                  background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%)',
                  backdropFilter: 'blur(10px)',
                  border: '1px solid rgba(135, 206, 250, 0.2)',
                  boxShadow: '0 4px 16px rgba(135, 206, 250, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8)',
                }}
              >
                <Typography variant="h6" sx={{ mb: 3, color: '#4A90E2', fontWeight: 600 }}>
                  ویژگی‌های عمومی
                </Typography>
                
                <Grid container spacing={3}>
                  <Grid item xs={12} md={6}>
                    <TextField
                      fullWidth
                      label="عنوان *"
                      value={formData.name}
                      onChange={(e) => handleChange('name', e.target.value)}
                      required
                      error={!formData.name}
                      helperText={!formData.name ? 'عنوان فیلد اجباری است' : ''}
                      sx={{
                        '& .MuiOutlinedInput-root': {
                          background: 'rgba(255, 255, 255, 0.8)',
                          backdropFilter: 'blur(10px)',
                          '&:hover': { boxShadow: '0 4px 12px rgba(74, 144, 226, 0.15)' },
                          '&.Mui-focused': { boxShadow: '0 0 0 3px rgba(74, 144, 226, 0.1)' },
                        },
                      }}
                    />
                  </Grid>
                  
                  <Grid item xs={12} md={6}>
                    <TextField
                      fullWidth
                      label="کلید یکتا *"
                      value={formData.englishName}
                      onChange={(e) => handleChange('englishName', e.target.value)}
                      required
                      error={!formData.englishName}
                      helperText={!formData.englishName ? 'کلید یکتا اجباری است' : 'فقط حروف انگلیسی، اعداد و _ مجاز است'}
                      placeholder="field_name"
                      sx={{
                        '& .MuiOutlinedInput-root': {
                          background: 'rgba(255, 255, 255, 0.8)',
                          backdropFilter: 'blur(10px)',
                          '&:hover': { boxShadow: '0 4px 12px rgba(74, 144, 226, 0.15)' },
                          '&.Mui-focused': { boxShadow: '0 0 0 3px rgba(74, 144, 226, 0.1)' },
                        },
                      }}
                    />
                  </Grid>
                  
                  <Grid item xs={12} md={6}>
                    <FormControl fullWidth>
                      <InputLabel>جهت متن</InputLabel>
                      <Select
                        value={formData.direction || 'auto'}
                        onChange={(e) => handleChange('direction', e.target.value)}
                        label="جهت متن"
                        sx={{
                          background: 'rgba(255, 255, 255, 0.8)',
                          backdropFilter: 'blur(10px)',
                        }}
                      >
                        <MenuItem value="auto">خودکار</MenuItem>
                        <MenuItem value="rtl">راست‌به‌چپ</MenuItem>
                        <MenuItem value="ltr">چپ‌به‌راست</MenuItem>
                      </Select>
                    </FormControl>
                  </Grid>
                </Grid>
              </Paper>
              
              {/* ویژگی‌های اختیاری */}
              <Paper
                sx={{
                  p: 3,
                  mb: 3,
                  borderRadius: '12px',
                  background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%)',
                  backdropFilter: 'blur(10px)',
                  border: '1px solid rgba(135, 206, 250, 0.2)',
                  boxShadow: '0 4px 16px rgba(135, 206, 250, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8)',
                }}
              >
                <Typography variant="h6" sx={{ mb: 3, color: '#4A90E2', fontWeight: 600 }}>
                  ویژگی‌های اختیاری
                </Typography>
                
                <Grid container spacing={3}>
                  {/* Placeholder */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enablePlaceholder || false}
                            onChange={(e) => handleChange('enablePlaceholder', e.target.checked)}
                            size="small"
                          />
                        }
                        label="راهنما"
                        sx={{ mb: 1 }}
                      />
                      <HelpTooltip
                        title="راهنما"
                        description="کمک می‌کند کاربر بفهمد چه چیزی بنویسد؛ با تایپ محو می‌شود."
                        example="«مثلاً: توضیح کوتاه…»"
                      />
                    </Box>
                    {formData.enablePlaceholder && (
                      <TextField
                        fullWidth
                        label="متن راهنما"
                        value={formData.placeholder || ''}
                        onChange={(e) => handleChange('placeholder', e.target.value)}
                        placeholder="مثال: نام خود را وارد کنید"
                        sx={{
                          '& .MuiOutlinedInput-root': {
                            background: 'rgba(255, 255, 255, 0.8)',
                            backdropFilter: 'blur(10px)',
                          },
                        }}
                      />
                    )}
                  </Grid>
                  
                  {/* Help Text */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableHelpText || false}
                            onChange={(e) => handleChange('enableHelpText', e.target.checked)}
                            size="small"
                          />
                        }
                        label="توضیح کوتاه زیر فیلد"
                        sx={{ mb: 1 }}
                      />
                      <HelpTooltip
                        title="توضیح کوتاه زیر فیلد"
                        description="راهنمای ثابت زیر فیلد برای قوانین/نکات."
                        example="«حداکثر ۱۴۰ کاراکتر.»"
                      />
                    </Box>
                    {formData.enableHelpText && (
                      <TextField
                        fullWidth
                        label="متن راهنما"
                        value={formData.helpText || ''}
                        onChange={(e) => handleChange('helpText', e.target.value)}
                        multiline
                        rows={2}
                        placeholder="توضیح کوتاه که زیر فیلد نمایش داده می‌شود"
                        sx={{
                          '& .MuiOutlinedInput-root': {
                            background: 'rgba(255, 255, 255, 0.8)',
                            backdropFilter: 'blur(10px)',
                          },
                        }}
                      />
                    )}
                  </Grid>
                </Grid>
              </Paper>
              
              {/* ویژگی‌های محتوایی */}
              <Paper
                sx={{
                  p: 3,
                  borderRadius: '12px',
                  background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%)',
                  backdropFilter: 'blur(10px)',
                  border: '1px solid rgba(135, 206, 250, 0.2)',
                  boxShadow: '0 4px 16px rgba(135, 206, 250, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8)',
                }}
              >
                <Typography variant="h6" sx={{ mb: 3, color: '#4A90E2', fontWeight: 600 }}>
                  ویژگی‌های محتوایی
                </Typography>
                
                <Grid container spacing={3}>
                  {/* Character Set */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableCharsetControl || false}
                            onChange={(e) => handleChange('enableCharsetControl', e.target.checked)}
                            size="small"
                          />
                        }
                        label="کنترل نوع کاراکترها"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="کنترل نوع کاراکترها"
                        description="محدودکردن نوع ورودی: فقط حروف، حروف+عدد، یا همه."
                        example="«فقط حروف و اعداد مجازند.»"
                      />
                    </Box>
                    {formData.enableCharsetControl && (
                      <FormControl fullWidth>
                        <InputLabel>نوع کاراکترهای مجاز</InputLabel>
                        <Select
                          value={formData.allowedCharset || 'all'}
                          onChange={(e) => handleChange('allowedCharset', e.target.value)}
                          label="نوع کاراکترهای مجاز"
                          sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                        >
                          <MenuItem value="letters">فقط حروف</MenuItem>
                          <MenuItem value="alphanumeric">حروف + عدد</MenuItem>
                          <MenuItem value="all">همه کاراکترها</MenuItem>
                          <MenuItem value="custom">سفارشی (با Regex)</MenuItem>
                        </Select>
                      </FormControl>
                    )}
                  </Grid>
                  
                  {/* Case Transform */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableCaseTransform || false}
                            onChange={(e) => handleChange('enableCaseTransform', e.target.checked)}
                            size="small"
                          />
                        }
                        label="تبدیل حروف"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="تبدیل حروف"
                        description="یکپارچه‌سازی حروف: بدون تغییر/همه کوچک/همه بزرگ/حرف اول بزرگ."
                        example="«john doe ← John doe»"
                      />
                    </Box>
                    {formData.enableCaseTransform && (
                      <FormControl fullWidth>
                        <InputLabel>نوع تبدیل</InputLabel>
                        <Select
                          value={formData.caseTransform || 'none'}
                          onChange={(e) => handleChange('caseTransform', e.target.value)}
                          label="نوع تبدیل"
                          sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                        >
                          <MenuItem value="none">بدون تغییر</MenuItem>
                          <MenuItem value="lowercase">همه کوچک</MenuItem>
                          <MenuItem value="uppercase">همه بزرگ</MenuItem>
                          <MenuItem value="capitalize">حرف اول بزرگ</MenuItem>
                        </Select>
                      </FormControl>
                    )}
                  </Grid>
                  
                  {/* Additional Options */}
                  <Grid item xs={12}>
                    <Typography variant="subtitle2" sx={{ mb: 2, fontWeight: 600, color: '#64748B' }}>
                      گزینه‌های اضافی:
                    </Typography>
                    
                    <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 2 }}>
                      <Box sx={{ display: 'flex', alignItems: 'center' }}>
                        <FormControlLabel
                          control={
                            <Switch
                              checked={formData.trimWhitespace || false}
                              onChange={(e) => handleChange('trimWhitespace', e.target.checked)}
                              size="small"
                            />
                          }
                          label="حذف فاصله‌های اضافی"
                        />
                        <HelpTooltip
                          title="حذف فاصله‌های اضافی"
                          description="فاصله‌های تکراری و ابتدا/انتها خودکار حذف می‌شود."
                          example="«  سلام    دنیا  ← سلام دنیا»"
                        />
                      </Box>
                      
                      <Box sx={{ display: 'flex', alignItems: 'center' }}>
                        <FormControlLabel
                          control={
                            <Switch
                              checked={formData.normalizeDigits || false}
                              onChange={(e) => handleChange('normalizeDigits', e.target.checked)}
                              size="small"
                            />
                          }
                          label="تبدیل اعداد فارسی/انگلیسی"
                        />
                        <HelpTooltip
                          title="تبدیل اعداد فارسی/انگلیسی"
                          description="ارقام ورودی به قالب دلخواه نرمال می‌شوند."
                          example="«۱۲۳ → 123»"
                        />
                      </Box>
                      
                      <Box sx={{ display: 'flex', alignItems: 'center' }}>
                        <FormControlLabel
                          control={
                            <Switch
                              checked={formData.fixZWNJ || false}
                              onChange={(e) => handleChange('fixZWNJ', e.target.checked)}
                              size="small"
                            />
                          }
                          label="اصلاح نیم‌فاصله"
                        />
                        <HelpTooltip
                          title="اصلاح نیم‌فاصله"
                          description="نیم‌فاصله‌های نادرست در فارسی اصلاح/یکنواخت می‌شود."
                          example="«می باشد → می‌شود»"
                        />
                      </Box>
                      
                      <Box sx={{ display: 'flex', alignItems: 'center' }}>
                        <FormControlLabel
                          control={
                            <Switch
                              checked={formData.allowEmoji || false}
                              onChange={(e) => handleChange('allowEmoji', e.target.checked)}
                              size="small"
                            />
                          }
                          label="اجازه ایموجی"
                        />
                        <HelpTooltip
                          title="اجازه ایموجی"
                          description="تعیین مجازبودن کاراکترهای Emoji."
                          example="«😊 مجاز است / مسدود می‌شود»"
                        />
                      </Box>
                      
                      <Box sx={{ display: 'flex', alignItems: 'center' }}>
                        <FormControlLabel
                          control={
                            <Switch
                              checked={formData.allowMarkdown || false}
                              onChange={(e) => handleChange('allowMarkdown', e.target.checked)}
                              size="small"
                            />
                          }
                          label="اجازه Markdown"
                        />
                        <HelpTooltip
                          title="اجازه Markdown"
                          description="اجازهٔ نشانه‌گذاری ساده متن‌غنی (با Sanitization)."
                          example="«*پررنگ*، _کج_»"
                        />
                      </Box>
                    </Box>
                  </Grid>
                </Grid>
              </Paper>
              
              {/* ویژگی‌های کمکی */}
              <Paper
                sx={{
                  p: 3,
                  mb: 3,
                  borderRadius: '12px',
                  background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%)',
                  backdropFilter: 'blur(10px)',
                  border: '1px solid rgba(135, 206, 250, 0.2)',
                  boxShadow: '0 4px 16px rgba(135, 206, 250, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8)',
                }}
              >
                <Typography variant="h6" sx={{ mb: 3, color: '#4A90E2', fontWeight: 600 }}>
                  ویژگی‌های کمکی
                </Typography>
                
                <Grid container spacing={3}>
                  {/* Suggestions */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableSuggestions || false}
                            onChange={(e) => handleChange('enableSuggestions', e.target.checked)}
                            size="small"
                          />
                        }
                        label="لیست پیشنهاد"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="لیست پیشنهاد"
                        description="پیشنهادهای آماده برای ورود سریع/یکنواخت."
                        example="«پیگیری شد»، «تماس بگیرد»"
                      />
                    </Box>
                    {formData.enableSuggestions && (
                      <TextField
                        fullWidth
                        label="پیشنهادها (هر خط یک پیشنهاد)"
                        value={formData.suggestions?.join('\n') || ''}
                        onChange={(e) => handleChange('suggestions', e.target.value.split('\n').filter(s => s.trim()))}
                        multiline
                        rows={3}
                        placeholder="مثال:\nنام اول\nنام دوم\nنام سوم"
                        sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                      />
                    )}
                  </Grid>
                  
                  {/* Auto-Complete */}
                  <Grid item xs={12} md={6}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.autoComplete || false}
                            onChange={(e) => handleChange('autoComplete', e.target.checked)}
                            size="small"
                          />
                        }
                        label="تکمیل خودکار"
                      />
                      <HelpTooltip
                        title="تکمیل خودکار"
                        description="با تایپ کاربر، از پیشنهادها کامل می‌کند."
                        example="تایپ «پیگ…» → «پیگیری شد»"
                      />
                    </Box>
                  </Grid>
                  
                  {/* Multi-Value */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableMultiValue || false}
                            onChange={(e) => handleChange('enableMultiValue', e.target.checked)}
                            size="small"
                          />
                        }
                        label="مقدار چندگانه"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="مقدار چندگانه"
                        description="امکان چند ورودی در یک فیلد با جداکننده."
                        example="«تهران, اصفهان, شیراز»"
                      />
                    </Box>
                    {formData.enableMultiValue && (
                      <Box sx={{ mt: 2 }}>
                        <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                          <Typography variant="body2" sx={{ mr: 2, fontWeight: 500 }}>
                            جداکننده:
                          </Typography>
                          <HelpTooltip
                            title="جداکننده‌ها"
                            description="کنترل نحوهٔ تفکیک مقادیر چندگانه."
                            example="«Enter» هر مورد را ثبت کند."
                          />
                        </Box>
                        <FormControl fullWidth>
                          <InputLabel>جداکننده</InputLabel>
                          <Select
                            value={formData.multiValueSeparator || 'comma'}
                            onChange={(e) => handleChange('multiValueSeparator', e.target.value)}
                            label="جداکننده"
                            sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                          >
                            <MenuItem value="comma">کاما (,)</MenuItem>
                            <MenuItem value="enter">اینتر</MenuItem>
                            <MenuItem value="space">فاصله</MenuItem>
                          </Select>
                        </FormControl>
                      </Box>
                    )}
                  </Grid>
                  
                  {/* Spellcheck */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableSpellcheck || false}
                            onChange={(e) => handleChange('enableSpellcheck', e.target.checked)}
                            size="small"
                          />
                        }
                        label="غلط‌یاب"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="غلط‌یاب"
                        description="بررسی املای کلمات (fa/en/سفارشی/خاموش)."
                        example="زیرخط قرمز برای کلمهٔ مشکوک."
                      />
                    </Box>
                    {formData.enableSpellcheck && (
                      <Grid container spacing={2}>
                        <Grid item xs={6}>
                          <FormControl fullWidth>
                            <InputLabel>زبان فرهنگ لغت</InputLabel>
                            <Select
                              value={formData.spellcheck || 'fa'}
                              onChange={(e) => handleChange('spellcheck', e.target.value)}
                              label="زبان فرهنگ لغت"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="fa">فارسی</MenuItem>
                              <MenuItem value="en">انگلیسی</MenuItem>
                              <MenuItem value="custom">سفارشی</MenuItem>
                              <MenuItem value="off">خاموش</MenuItem>
                            </Select>
                          </FormControl>
                        </Grid>
                        {formData.spellcheck === 'custom' && (
                          <Grid item xs={6}>
                            <Box sx={{ display: 'flex', alignItems: 'center' }}>
                              <TextField
                                fullWidth
                                label="فرهنگ لغت سفارشی"
                                value={formData.customDictionary || ''}
                                onChange={(e) => handleChange('customDictionary', e.target.value)}
                                placeholder="کلمات مجاز با کاما جدا شده"
                                sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                              />
                              <HelpTooltip
                                title="فرهنگ لغت سفارشی"
                                description="افزودن واژگان سازمانی به غلط‌یاب."
                                example="اضافه‌کردن نام برند داخلی."
                              />
                            </Box>
                          </Grid>
                        )}
                      </Grid>
                    )}
                  </Grid>
                </Grid>
              </Paper>
              
              {/* ویژگی‌های رفتار و منطق */}
              <Paper
                sx={{
                  p: 3,
                  mb: 3,
                  borderRadius: '12px',
                  background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%)',
                  backdropFilter: 'blur(10px)',
                  border: '1px solid rgba(135, 206, 250, 0.2)',
                  boxShadow: '0 4px 16px rgba(135, 206, 250, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8)',
                }}
              >
                <Typography variant="h6" sx={{ mb: 3, color: '#4A90E2', fontWeight: 600 }}>
                  رفتار و منطق
                </Typography>
                
                <Grid container spacing={3}>
                  {/* Editable After Save */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.editableAfterSave !== false}
                            onChange={(e) => handleChange('editableAfterSave', e.target.checked)}
                            size="small"
                          />
                        }
                        label="قابل‌ویرایش بعد از ثبت"
                        sx={{ mb: 1 }}
                      />
                      <HelpTooltip
                        title="قابل‌ویرایش بعد از ثبت"
                        description="قفل یا بازبودن ویرایش پس از ذخیره."
                        example="«پس از تأیید نهایی، غیرقابل‌ویرایش.»"
                      />
                    </Box>
                  </Grid>
                  
                  {/* Debounce & Autosave */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableAutosave || false}
                            onChange={(e) => handleChange('enableAutosave', e.target.checked)}
                            size="small"
                          />
                        }
                        label="ذخیره خودکار"
                        sx={{ mb: 1 }}
                      />
                      <HelpTooltip
                        title="ذخیره خودکار"
                        description="ذخیرهٔ خودکار بعد از مکث تایپ یا بازهٔ زمانی."
                        example="«۳۰۰ms دی‌بونس، هر ۵s ذخیره.»"
                      />
                    </Box>
                    {formData.enableAutosave && (
                      <Grid container spacing={2} sx={{ mt: 1 }}>
                        <Grid item xs={6}>
                          <TextField
                            fullWidth
                            type="number"
                            label="زمان تأخیر (میلی‌ثانیه)"
                            value={formData.debounceTime || 500}
                            onChange={(e) => handleChange('debounceTime', parseInt(e.target.value) || 500)}
                            placeholder="500"
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                        </Grid>
                        <Grid item xs={6}>
                          <TextField
                            fullWidth
                            type="number"
                            label="فاصله ذخیره (ثانیه)"
                            value={formData.autosaveInterval || 30}
                            onChange={(e) => handleChange('autosaveInterval', parseInt(e.target.value) || 30)}
                            placeholder="30"
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                        </Grid>
                      </Grid>
                    )}
                  </Grid>
                </Grid>
              </Paper>
              
              {/* ویژگی‌های امنیت و ذخیره‌سازی */}
              <Paper
                sx={{
                  p: 3,
                  mb: 3,
                  borderRadius: '12px',
                  background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%)',
                  backdropFilter: 'blur(10px)',
                  border: '1px solid rgba(135, 206, 250, 0.2)',
                  boxShadow: '0 4px 16px rgba(135, 206, 250, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8)',
                }}
              >
                <Typography variant="h6" sx={{ mb: 3, color: '#4A90E2', fontWeight: 600 }}>
                  امنیت و ذخیره‌سازی
                </Typography>
                
                <Grid container spacing={3}>
                  {/* PII Check */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.piiCheck?.enabled || false}
                            onChange={(e) => {
                              const pii = formData.piiCheck || {};
                              handleChange('piiCheck', { ...pii, enabled: e.target.checked });
                            }}
                            size="small"
                          />
                        }
                        label="تشخیص اطلاعات حساس"
                        sx={{ mb: 1 }}
                      />
                      <HelpTooltip
                        title="تشخیص اطلاعات حساس"
                        description="شناسایی ایمیل/شماره ملی/… و هشدار/مسدود."
                        example="«example@mail.com → هشدار»"
                      />
                    </Box>
                    {formData.piiCheck?.enabled && (
                      <Grid container spacing={2} sx={{ mt: 1 }}>
                        <Grid item xs={6}>
                          <FormControl fullWidth>
                            <InputLabel>عمل</InputLabel>
                            <Select
                              value={formData.piiCheck?.action || 'warn'}
                              onChange={(e) => {
                                const pii = formData.piiCheck || {};
                                handleChange('piiCheck', { ...pii, action: e.target.value });
                              }}
                              label="عمل"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="warn">هشدار</MenuItem>
                              <MenuItem value="block">مسدود</MenuItem>
                            </Select>
                          </FormControl>
                        </Grid>
                        <Grid item xs={6}>
                          <TextField
                            fullWidth
                            label="الگوهای سفارشی"
                            value={(formData.piiCheck?.patterns || []).join(', ')}
                            onChange={(e) => {
                              const pii = formData.piiCheck || {};
                              handleChange('piiCheck', { ...pii, patterns: e.target.value.split(',').map(p => p.trim()) });
                            }}
                            placeholder="الگوها را با کاما جدا کنید"
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                        </Grid>
                      </Grid>
                    )}
                  </Grid>
                  
                  {/* Profanity Check */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.profanityCheck?.enabled || false}
                            onChange={(e) => {
                              const profanity = formData.profanityCheck || {};
                              handleChange('profanityCheck', { ...profanity, enabled: e.target.checked });
                            }}
                            size="small"
                          />
                        }
                        label="تشخیص کلمات نامناسب"
                        sx={{ mb: 1 }}
                      />
                      <HelpTooltip
                        title="تشخیص کلمات نامناسب"
                        description="شناسایی واژگان نامناسب؛ هشدار/مسدود."
                        example="«لیست کلمات سفارشی سازمان»"
                      />
                    </Box>
                    {formData.profanityCheck?.enabled && (
                      <Grid container spacing={2} sx={{ mt: 1 }}>
                        <Grid item xs={6}>
                          <FormControl fullWidth>
                            <InputLabel>عمل</InputLabel>
                            <Select
                              value={formData.profanityCheck?.action || 'warn'}
                              onChange={(e) => {
                                const profanity = formData.profanityCheck || {};
                                handleChange('profanityCheck', { ...profanity, action: e.target.value });
                              }}
                              label="عمل"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="warn">هشدار</MenuItem>
                              <MenuItem value="block">مسدود</MenuItem>
                            </Select>
                          </FormControl>
                        </Grid>
                        <Grid item xs={6}>
                          <TextField
                            fullWidth
                            label="کلمات سفارشی"
                            value={(formData.profanityCheck?.customWords || []).join(', ')}
                            onChange={(e) => {
                              const profanity = formData.profanityCheck || {};
                              handleChange('profanityCheck', { ...profanity, customWords: e.target.value.split(',').map(w => w.trim()) });
                            }}
                            placeholder="کلمات را با کاما جدا کنید"
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                        </Grid>
                      </Grid>
                    )}
                  </Grid>
                  
                  {/* Indexing */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                      <Typography variant="body2" sx={{ fontWeight: 600, color: '#64748B' }}>
                        نمایه‌سازی
                      </Typography>
                      <HelpTooltip
                        title="نمایه‌سازی"
                        description="قابلیت جست‌وجو و فیلتر روی این فیلد."
                        example="«این فیلد در نتایج جست‌وجو می‌آید»"
                      />
                    </Box>
                    <Grid container spacing={2}>
                      <Grid item xs={6}>
                        <FormControlLabel
                          control={
                            <Switch
                              checked={formData.indexing?.searchable !== false}
                              onChange={(e) => {
                                const indexing = formData.indexing || {};
                                handleChange('indexing', { ...indexing, searchable: e.target.checked });
                              }}
                              size="small"
                            />
                          }
                          label="قابل جستجو"
                        />
                      </Grid>
                      <Grid item xs={6}>
                        <FormControlLabel
                          control={
                            <Switch
                              checked={formData.indexing?.filterable !== false}
                              onChange={(e) => {
                                const indexing = formData.indexing || {};
                                handleChange('indexing', { ...indexing, filterable: e.target.checked });
                              }}
                              size="small"
                            />
                          }
                          label="قابل فیلتر"
                        />
                      </Grid>
                    </Grid>
                  </Grid>
                  
                  {/* Analyzer */}
                  <Grid item xs={12} md={6}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControl fullWidth>
                        <InputLabel>آنالایزر جستجو</InputLabel>
                        <Select
                          value={formData.analyzer || 'standard'}
                          onChange={(e) => handleChange('analyzer', e.target.value)}
                          label="آنالایزر جستجو"
                          sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                        >
                          <MenuItem value="standard">استاندارد</MenuItem>
                          <MenuItem value="persian">فارسی</MenuItem>
                        </Select>
                      </FormControl>
                      <HelpTooltip
                        title="آنالایزر جست‌وجو"
                        description="بهبود تطبیق جست‌وجو با زبان/ریشه‌یابی."
                        example="«می‌روم ≈ رفتن (fa analyzer)»"
                      />
                    </Box>
                  </Grid>
                  
                  {/* Store Raw & Normalized */}
                  <Grid item xs={12} md={6}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.storeRawAndNormalized || false}
                            onChange={(e) => handleChange('storeRawAndNormalized', e.target.checked)}
                            size="small"
                          />
                        }
                        label="ذخیره نسخه خام و نرمال‌شده"
                      />
                      <HelpTooltip
                        title="ذخیره نسخه خام و نرمال‌شده"
                        description="نگه‌داری مقدار ورودی و نسخهٔ استاندارد شده."
                        example="مقدار خام: ۱۲۳ و نرمال: 123"
                      />
                    </Box>
                  </Grid>
                </Grid>
              </Paper>
              <Paper
                sx={{
                  p: 3,
                  borderRadius: '12px',
                  background: 'linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(248, 250, 252, 0.8) 100%)',
                  backdropFilter: 'blur(10px)',
                  border: '1px solid rgba(135, 206, 250, 0.2)',
                  boxShadow: '0 4px 16px rgba(135, 206, 250, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.8)',
                }}
              >
                <Typography variant="h6" sx={{ mb: 3, color: '#4A90E2', fontWeight: 600 }}>
                  ویژگی‌های نمایشی
                </Typography>
                
                <Grid container spacing={3}>
                  {/* Variant */}
                  <Grid item xs={12}>
                    <Box sx={{ display: 'flex', alignItems: 'center' }}>
                      <FormControlLabel
                        control={
                          <Switch
                            checked={formData.enableVariant || false}
                            onChange={(e) => handleChange('enableVariant', e.target.checked)}
                            size="small"
                          />
                        }
                        label="نوع نمایش"
                        sx={{ mb: 2 }}
                      />
                      <HelpTooltip
                        title="نوع نمایش"
                        description="الگوی UI فیلد: ساده/آکاردئونی/چندخطی/متن‌غنی/درجا/چیپ‌ها/پِل/ماسک/پاپ‌اور."
                        example="«یادداشت طولانی ⇒ TextArea»"
                      />
                    </Box>
                    {formData.enableVariant && (
                      <FormControl fullWidth>
                        <InputLabel>نوع نمایش</InputLabel>
                        <Select
                          value={formData.variant || 'plain'}
                          onChange={(e) => handleChange('variant', e.target.value)}
                          label="نوع نمایش"
                          sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                        >
                          <MenuItem value="plain">معمولی</MenuItem>
                          <MenuItem value="accordion">آکاردئونی</MenuItem>
                          <MenuItem value="textarea">چندخطی</MenuItem>
                          <MenuItem value="richtext">متن غنی</MenuItem>
                          <MenuItem value="inline">ویرایش درجا</MenuItem>
                          <MenuItem value="chips">چیپ‌ها</MenuItem>
                          <MenuItem value="pill">پِل/بج</MenuItem>
                          <MenuItem value="masked">ماسک‌شده</MenuItem>
                          <MenuItem value="popover">پاپ‌اور/مودال</MenuItem>
                        </Select>
                      </FormControl>
                    )}
                  </Grid>
                  
                  {/* Accordion Configuration */}
                  {formData.enableVariant && formData.variant === 'accordion' && (
                    <>
                      {/* Accordion Display Mode */}
                      <Grid item xs={12}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>نحوه نمایش آکاردئون</InputLabel>
                            <Select
                              value={formData.accordionDisplayMode || 'title'}
                              onChange={(e) => handleChange('accordionDisplayMode', e.target.value)}
                              label="نحوه نمایش آکاردئون"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="title">نمایش عنوان ثابت</MenuItem>
                              <MenuItem value="options">نمایش گزینه‌های انتخابی</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="نحوه نمایش آکاردئون"
                            description="تعیین کنید که آکاردئون فقط عنوان نمایش دهد یا گزینه‌هایی برای انتخاب ارائه کند."
                            example="«عنوان ثابت: نمایش اطلاعات / گزینه‌های انتخابی: انتخاب از لیست»"
                          />
                        </Box>
                      </Grid>
                      
                      {/* Accordion Title - Only when title mode */}
                      {formData.accordionDisplayMode === 'title' && (
                        <Grid item xs={12}>
                          <Box sx={{ display: 'flex', alignItems: 'center' }}>
                            <TextField
                              fullWidth
                              label="عنوان آکاردئون"
                              value={formData.accordionTitle || ''}
                              onChange={(e) => handleChange('accordionTitle', e.target.value)}
                              placeholder="عنوان نمایش‌داده‌شده روی آکاردئون"
                              sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                            />
                            <HelpTooltip
                              title="عنوان آکاردئون"
                              description="عنوانی که روی سکشن جمع‌شونده نمایش می‌دهد (فقط نمایشی)."
                              example="«توضیحات پیشرفته»"
                            />
                          </Box>
                        </Grid>
                      )}
                      
                      {/* Accordion Options - Only when options mode */}
                      {formData.accordionDisplayMode === 'options' && (
                        <Grid item xs={12}>
                          <Box sx={{ display: 'flex', alignItems: 'center', mb: 1 }}>
                            <Typography variant="subtitle2" sx={{ color: 'text.secondary' }}>
                              گزینه‌های انتخابی آکاردئون
                            </Typography>
                            <HelpTooltip
                              title="گزینه‌های انتخابی آکاردئون"
                              description="گزینه‌هایی که کاربر می‌تواند از داخل آکاردئون انتخاب کند."
                              example="«ویژگی عمومی، ویژگی تخصصی، سایر ویژگی‌ها»"
                            />
                          </Box>
                          
                          {/* Options List */}
                          <Box sx={{ mb: 2 }}>
                            {(formData.options || []).map((option, index) => (
                              <Box
                                key={index}
                                sx={{
                                  display: 'flex',
                                  alignItems: 'center',
                                  gap: 1,
                                  mb: 1,
                                  p: 1,
                                  border: '1px solid',
                                  borderColor: 'divider',
                                  borderRadius: 1,
                                  backgroundColor: 'rgba(255, 255, 255, 0.8)'
                                }}
                              >
                                <TextField
                                  fullWidth
                                  size="small"
                                  value={option}
                                  onChange={(e) => {
                                    const newOptions = [...(formData.options || [])];
                                    newOptions[index] = e.target.value;
                                    handleChange('options', newOptions);
                                  }}
                                  placeholder={`گزینه ${index + 1}`}
                                  variant="outlined"
                                />
                                <IconButton
                                  size="small"
                                  color="error"
                                  onClick={() => {
                                    const newOptions = [...(formData.options || [])];
                                    newOptions.splice(index, 1);
                                    handleChange('options', newOptions);
                                  }}
                                  sx={{ minWidth: 'auto', p: 0.5 }}
                                >
                                  ✕
                                </IconButton>
                              </Box>
                            ))}
                            
                            {(!formData.options || formData.options.length === 0) && (
                              <Typography
                                variant="body2"
                                color="text.secondary"
                                sx={{ textAlign: 'center', py: 2, fontStyle: 'italic' }}
                              >
                                هنوز گزینه‌ای اضافه نشده است
                              </Typography>
                            )}
                          </Box>
                          
                          {/* Add New Option */}
                          <Box sx={{ display: 'flex', gap: 1 }}>
                            <TextField
                              fullWidth
                              size="small"
                              placeholder="گزینه جدید را بنویسید..."
                              value={formData.newOptionText || ''}
                              onChange={(e) => handleChange('newOptionText', e.target.value)}
                              onKeyPress={(e) => {
                                if (e.key === 'Enter' && formData.newOptionText?.trim()) {
                                  const newOptions = [...(formData.options || []), formData.newOptionText.trim()];
                                  handleChange('options', newOptions);
                                  handleChange('newOptionText', '');
                                }
                              }}
                              sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.9)' } }}
                            />
                            <Button
                              variant="outlined"
                              size="small"
                              onClick={() => {
                                if (formData.newOptionText?.trim()) {
                                  const newOptions = [...(formData.options || []), formData.newOptionText.trim()];
                                  handleChange('options', newOptions);
                                  handleChange('newOptionText', '');
                                }
                              }}
                              disabled={!formData.newOptionText?.trim()}
                              sx={{ minWidth: 'auto', px: 2 }}
                            >
                              افزودن
                            </Button>
                          </Box>
                        </Grid>
                      )}
                    </>
                  )}
                  
                  {/* Mask Pattern */}
                  {formData.enableVariant && formData.variant === 'masked' && (
                    <Grid item xs={12}>
                      <Box sx={{ display: 'flex', alignItems: 'center' }}>
                        <TextField
                          fullWidth
                          label="الگوی ماسک"
                          value={formData.maskPattern || ''}
                          onChange={(e) => handleChange('maskPattern', e.target.value)}
                          placeholder="مثال: ####-##-## (# = رقم)"
                          sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                        />
                        <HelpTooltip
                          title="الگوی ماسک"
                          description="اجبار به فرم خاصِ نمایش/ورود."
                          example="«####-##-##» برای تاریخ"
                        />
                      </Box>
                    </Grid>
                  )}
                  
                  {/* Textarea Configuration */}
                  {formData.enableVariant && formData.variant === 'textarea' && (
                    <>
                      <Grid item xs={12}>
                        <Typography variant="subtitle2" sx={{ color: 'text.secondary', mb: 2 }}>
                          تنظیمات متن چندخطی
                        </Typography>
                      </Grid>
                      
                      <Grid item xs={6}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <TextField
                            fullWidth
                            type="number"
                            label="تعداد خطوط"
                            value={formData.textareaRows || 4}
                            onChange={(e) => handleChange('textareaRows', parseInt(e.target.value) || 4)}
                            inputProps={{ min: 2, max: 20 }}
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                          <HelpTooltip
                            title="تعداد خطوط"
                            description="تعداد خطوط قابل مشاهده در متن چندخطی."
                            example="«4 = 4 خط»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={6}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <TextField
                            fullWidth
                            type="number"
                            label="حداکثر خطوط"
                            value={formData.textareaMaxRows || 10}
                            onChange={(e) => handleChange('textareaMaxRows', parseInt(e.target.value) || 10)}
                            inputProps={{ min: formData.textareaRows || 4, max: 50 }}
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                          <HelpTooltip
                            title="حداکثر خطوط"
                            description="حداکثر خطوط قابل گسترش (اگر قابلیت تغییر اندازه فعال باشد)."
                            example="«10 = تا 10 خط قابل گسترش»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={12}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>قابلیت تغییر اندازه</InputLabel>
                            <Select
                              value={formData.textareaResize || 'vertical'}
                              onChange={(e) => handleChange('textareaResize', e.target.value)}
                              label="قابلیت تغییر اندازه"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="none">بدون تغییر اندازه</MenuItem>
                              <MenuItem value="vertical">عمودی (ارتفاع)</MenuItem>
                              <MenuItem value="horizontal">افقی (عرض)</MenuItem>
                              <MenuItem value="both">هر دو</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="قابلیت تغییر اندازه"
                            description="کاربر می‌تواند اندازه متن چندخطی را تغییر دهد."
                            example="«عمودی: فقط ارتفاع قابل تغییر»"
                          />
                        </Box>
                      </Grid>
                    </>
                  )}
                  
                  {/* Richtext Configuration */}
                  {formData.enableVariant && formData.variant === 'richtext' && (
                    <>
                      <Grid item xs={12}>
                        <Typography variant="subtitle2" sx={{ color: 'text.secondary', mb: 2 }}>
                          تنظیمات متن غنی
                        </Typography>
                      </Grid>
                      
                      <Grid item xs={12}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <TextField
                            fullWidth
                            type="number"
                            label="ارتفاع ویرایشگر (پیکسل)"
                            value={formData.richtextHeight || 300}
                            onChange={(e) => handleChange('richtextHeight', parseInt(e.target.value) || 300)}
                            inputProps={{ min: 200, max: 800 }}
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                          <HelpTooltip
                            title="ارتفاع ویرایشگر"
                            description="ارتفاع محیط ویرایش متن غنی به پیکسل."
                            example="«300 = 300 پیکسل ارتفاع»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={12}>
                        <Box sx={{ display: 'flex', alignItems: 'center', mb: 1 }}>
                          <Typography variant="subtitle2" sx={{ color: 'text.secondary' }}>
                            ابزارهای نوار ابزار
                          </Typography>
                          <HelpTooltip
                            title="ابزارهای نوار ابزار"
                            description="ابزارهای قابل دسترس در ویرایشگر متن غنی."
                            example="«بولد، ایتالیک، لینک، لیست»"
                          />
                        </Box>
                        
                        <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1, mb: 2 }}>
                          {[
                            { value: 'bold', label: 'بولد' },
                            { value: 'italic', label: 'ایتالیک' },
                            { value: 'underline', label: 'زیرخط' },
                            { value: 'link', label: 'لینک' },
                            { value: 'list', label: 'لیست' },
                            { value: 'quote', label: 'نقل قول' },
                            { value: 'code', label: 'کد' },
                            { value: 'image', label: 'تصویر' }
                          ].map((tool) => {
                            const toolbarArray = formData.richtextToolbar || [];
                            const isSelected = toolbarArray.includes(tool.value);
                            
                            return (
                              <Chip
                                key={tool.value}
                                label={tool.label}
                                variant={isSelected ? 'filled' : 'outlined'}
                                color={isSelected ? 'primary' : 'default'}
                                clickable
                                onClick={() => {
                                  const currentToolbar = formData.richtextToolbar || [];
                                  const newToolbar = isSelected 
                                    ? currentToolbar.filter(t => t !== tool.value)
                                    : [...currentToolbar, tool.value];
                                  handleChange('richtextToolbar', newToolbar);
                                }}
                                size="small"
                              />
                            );
                          })}
                        </Box>
                      </Grid>
                    </>
                  )}
                  
                  {/* Chips Configuration */}
                  {formData.enableVariant && formData.variant === 'chips' && (
                    <>
                      <Grid item xs={12}>
                        <Typography variant="subtitle2" sx={{ color: 'text.secondary', mb: 2 }}>
                          تنظیمات چیپ‌ها
                        </Typography>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>رنگ چیپ</InputLabel>
                            <Select
                              value={formData.chipsColor || 'default'}
                              onChange={(e) => handleChange('chipsColor', e.target.value)}
                              label="رنگ چیپ"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="default">پیش‌فرض</MenuItem>
                              <MenuItem value="primary">اصلی</MenuItem>
                              <MenuItem value="secondary">ثانویه</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="رنگ چیپ"
                            description="رنگ پایه چیپ‌های نمایشی."
                            example="«اصلی: آبی برند»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>نوع چیپ</InputLabel>
                            <Select
                              value={formData.chipsVariant || 'filled'}
                              onChange={(e) => handleChange('chipsVariant', e.target.value)}
                              label="نوع چیپ"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="filled">پرشده</MenuItem>
                              <MenuItem value="outlined">حاشیه‌دار</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="نوع چیپ"
                            description="نحوه نمایش چیپ‌ها: پرشده یا حاشیه‌دار."
                            example="«پرشده: رنگ زمینه دارد»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <TextField
                            fullWidth
                            type="number"
                            label="حداکثر تعداد"
                            value={formData.chipsMaxCount || 10}
                            onChange={(e) => handleChange('chipsMaxCount', parseInt(e.target.value) || 10)}
                            inputProps={{ min: 1, max: 50 }}
                            sx={{ '& .MuiOutlinedInput-root': { background: 'rgba(255, 255, 255, 0.8)' } }}
                          />
                          <HelpTooltip
                            title="حداکثر تعداد"
                            description="حداکثر تعداد چیپ‌های قابل نمایش."
                            example="«10 = بیشتر نمایش نمی‌دهد»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={12}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControlLabel
                            control={
                              <Switch
                                checked={formData.chipsDeletable ?? true}
                                onChange={(e) => handleChange('chipsDeletable', e.target.checked)}
                                size="small"
                              />
                            }
                            label="قابل حذف"
                          />
                          <HelpTooltip
                            title="قابل حذف"
                            description="کاربر می‌تواند چیپ‌ها را حذف کند."
                            example="«ایکس برای حذف»"
                          />
                        </Box>
                      </Grid>
                    </>
                  )}
                  
                  {/* Pill Configuration */}
                  {formData.enableVariant && formData.variant === 'pill' && (
                    <>
                      <Grid item xs={12}>
                        <Typography variant="subtitle2" sx={{ color: 'text.secondary', mb: 2 }}>
                          تنظیمات پِل/بج
                        </Typography>
                      </Grid>
                      
                      <Grid item xs={6}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>رنگ پِل</InputLabel>
                            <Select
                              value={formData.pillColor || 'primary'}
                              onChange={(e) => handleChange('pillColor', e.target.value)}
                              label="رنگ پِل"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="default">پیش‌فرض</MenuItem>
                              <MenuItem value="primary">اصلی</MenuItem>
                              <MenuItem value="secondary">ثانویه</MenuItem>
                              <MenuItem value="success">موفقیت</MenuItem>
                              <MenuItem value="warning">هشدار</MenuItem>
                              <MenuItem value="error">خطا</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="رنگ پِل"
                            description="رنگ پِل نمایشی مقدار."
                            example="«موفقیت: سبز»"
                          />
                        </Box>
                      </Grid>
                      
                      <Grid item xs={6}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>اندازه پِل</InputLabel>
                            <Select
                              value={formData.pillSize || 'medium'}
                              onChange={(e) => handleChange('pillSize', e.target.value)}
                              label="اندازه پِل"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="small">کوچک</MenuItem>
                              <MenuItem value="medium">متوسط</MenuItem>
                            </Select>
                          </FormControl>
                          <HelpTooltip
                            title="اندازه پِل"
                            description="اندازه پِل نمایشی."
                            example="«کوچک = compact»"
                          />
                        </Box>
                      </Grid>
                    </>
                  )}
                  
                  {/* Popover Configuration */}
                  {formData.enableVariant && formData.variant === 'popover' && (
                    <>
                      <Grid item xs={12}>
                        <Typography variant="subtitle2" sx={{ color: 'text.secondary', mb: 2 }}>
                          تنظیمات پاپ‌اور/مودال
                        </Typography>
                      </Grid>
                      
                      <Grid item xs={4}>
                        <Box sx={{ display: 'flex', alignItems: 'center' }}>
                          <FormControl fullWidth>
                            <InputLabel>نحوه بازشدن</InputLabel>
                            <Select
                              value={formData.popoverTrigger || 'click'}
                              onChange={(e) => handleChange('popoverTrigger', e.target.value)}
                              label="نحوه بازشدن"
                              sx={{ background: 'rgba(255, 255, 255, 0.8)' }}
                            >
                              <MenuItem value="click">کلیک</MenuItem>
                              <MenuItem value="hover">هاور</MenuItem>
