{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src/modules/definition-editor/**/*",
    "src/modules/definition-editor/typings/**/*"
  ],
  "exclude": []
}
