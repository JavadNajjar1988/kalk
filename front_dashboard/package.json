{
  "name": "sajed-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "سیستم مدیریت عملیات نظامی ساجد - Frontend",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck:definition-editor": "tsc --noEmit -p tsconfig.definition-editor.json",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "analyze": "npm run build && npx vite-bundle-analyzer dist",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "security-check": "npm audit --audit-level moderate",
    "deps-check": "npm outdated",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:definition-editor": "vitest run --dir src/modules/definition-editor",
    "validate:definition-editor": "node scripts/validate-definition-editor.cjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "1.1.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.11.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hello-pangea/dnd": "18.0.1",
    "@minoru/react-dnd-treeview": "^3.5.3",
    "@mui/icons-material": "5.18.0",
    "@mui/lab": "^5.0.0-alpha.155",
    "@mui/material": "5.18.0",
    "@mui/system": "^5.14.18",
    "@mui/x-date-pickers": "5.0.20",
    "@mui/x-tree-view": "8.9.0",
    "@reduxjs/toolkit": "^1.9.7",
    "@types/d3": "7.4.3",
    "@types/ol": "^6.5.3",
    "@types/react-transition-group": "4.4.12",
    "@types/resize-observer-browser": "0.1.11",
    "@xmldom/xmldom": "0.8.11",
    "@xyflow/react": "12.8.2",
    "axios": "^1.6.2",
    "country-state-city": "^3.2.1",
    "dagre": "^0.8.5",
    "date-fns": "^2.30.0",
    "date-fns-jalali": "^2.30.0-0",
    "dayjs": "^1.11.13",
    "file-saver": "2.0.5",
    "i18next": "^25.3.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "idb": "8.0.3",
    "iran-cities-json": "2.0.0",
    "iran-lib": "1.0.22",
    "iran-locations": "1.0.7",
    "jalali-moment": "^3.3.11",
    "klona": "^2.0.6",
    "milsymbol": "^3.0.2",
    "nanoid": "^5.1.5",
    "ol": "^8.2.0",
    "react": "^18.2.0",
    "react-date-object": "2.1.9",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^4.0.11",
    "react-globe.gl": "2.37.0",
    "react-i18next": "^15.6.0",
    "react-multi-date-picker": "4.5.2",
    "react-redux": "^8.1.3",
    "react-router-dom": "^6.20.1",
    "react-transition-group": "4.4.5",
    "react-window": "1.8.11",
    "react-window-infinite-loader": "^1.0.9",
    "redux-persist": "^6.0.0",
    "stylis": "^4.3.0",
