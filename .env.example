# PowerShell: Copy-Item .env.example .env

# ØªÙ†Ø¸ÛŒÙ…Ø§Øª Ø¯ÛŒØªØ§Ø¨ÛŒØ³
POSTGRES_USER=kalk
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_STRONG_DATABASE_PASSWORD
POSTGRES_DB=kalk
DB_URL=postgresql+asyncpg://kalk:CHANGE_ME_WITH_A_STRONG_DATABASE_PASSWORD@db:5432/kalk

# ØªÙ†Ø¸ÛŒÙ…Ø§Øª Ø§Ø­Ø±Ø§Ø² Ù‡ÙˆÛŒØª
DISABLE_AUTH=false
# Replace both values with strong, random secrets before starting the application.
