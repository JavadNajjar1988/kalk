# ØªÙ†Ø¸ÛŒÙ…Ø§Øª CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# ØªÙ†Ø¸ÛŒÙ…Ø§Øª Ù†Ù‚Ø´Ù‡ Ùˆ Ù†Ù‚Ø´Ù‡â€ŒÚ©Ø´ÛŒ
TILESERVER_PORT=8480
