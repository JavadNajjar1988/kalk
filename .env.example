# ØªÙ†Ø¸ÛŒÙ…Ø§Øª Ø¯ÛŒÚ¯Ø±
API_PREFIX=/api
ACCESS_TOKEN_EXPIRE_MINUTES=60

# کالک‌یار: استانداردسازی اکسل ناهمگون با مدل محلی سازگار با OpenAI
INTERNAL_LLM_BASE_URL=http://host.docker.internal:1234
INTERNAL_LLM_API_KEY=
