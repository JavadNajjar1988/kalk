# =============================================================================
# Kalk - Offline Bundle Environment File
# این فایل را به نام `.env` کنار docker-compose.offline.yml کپی کنید
# و در صورت نیاز مقادیر را تغییر دهید.
# =============================================================================

# --- Database (PostGIS) ---
# دیتابیس به صورت تازه و خالی روی مقصد ساخته می شود (volume: db-data)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kalk

# آدرس اتصال api به دیتابیس (داخل شبکه docker)
DB_URL=postgresql+asyncpg://postgres:postgres@db:5432/kalk

# --- Authentication ---
DISABLE_AUTH=false
JWT_SECRET=kalk-dev-local-jwt-secret
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_BOOTSTRAP_PASSWORD=admin123

# --- Maps ---
# مسیر داخل کانتینر api که نقشه‌ها از آنجا خوانده می‌شوند
FILESYSTEM_TILE_ROOT=/app/backend/static/maps
# آدرس پایه TileServer (از نگاه مرورگر). /tiles از nginx پراکسی می‌شود.
TILESERVER_URL=/tiles

# --- Simulator ---
# آدرس API از نگاه مرورگر کاربر (پورت میزبان api = 8002)
VITE_API_URL=http://localhost:8002/api
# توکن Cesium Ion (در صورت نیاز سناریوهای 3D)
VITE_CESIUM_ION_TOKEN=
